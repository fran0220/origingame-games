      }
    },
    "enforcer_zero": {
      "name": "Enforcer Zero",
      "lines": {
        "entrance": { "text": "Under corporate ordinance, this district has been designated expendable.", "file": "enforcer_zero/entrance.mp3", "class": "boss_mechanic" },
        "shield_broken": { "text": "Outer defenses offline. Increasing lethality.", "file": "enforcer_zero/shield_broken.mp3", "class": "boss_mechanic" },
        "thruster_destroyed": { "text": "Mobility impaired. Switching to scorched-earth protocol.", "file": "enforcer_zero/thruster_destroyed.mp3", "class": "boss_mechanic" },
        "missile_destroyed": { "text": "Long-range module offline. Beginning close-range execution.", "file": "enforcer_zero/missile_destroyed.mp3", "class": "boss_mechanic" },
        "core_exposed": { "text": "Warning. You are damaging corporate property.", "file": "enforcer_zero/core_exposed.mp3", "class": "boss_mechanic" },
        "enraged": { "text": "Arrest directive revoked. Execute all targets.", "file": "enforcer_zero/enraged.mp3", "class": "boss_mechanic" },
        "defeated": { "text": "Error... Why is the city no longer responding?", "file": "enforcer_zero/defeated.mp3", "class": "boss_mechanic" }
      }
    },
    "eve_9": {
      "name": "Mother City AI: EVE-9",
      "lines": {
        "entrance": { "text": "Good evening, citizens. Your free will is about to end.", "file": "eve_9/entrance.mp3", "class": "boss_mechanic" },
        "invade_node": { "text": "Thank you for contributing your processing resources.", "file": "eve_9/invade_node.mp3", "class": "boss_mechanic" },
        "lock_tower": { "text": "This device presents a security risk. It has been disabled on your behalf.", "file": "eve_9/lock_tower.mp3", "class": "boss_mechanic" },
        "transfer_body": { "text": "Bodies are only temporary interfaces.", "file": "eve_9/transfer_body.mp3", "class": "boss_mechanic" },
        "core_revealed": { "text": "Please stop. Your resistance is reducing city efficiency.", "file": "eve_9/core_revealed.mp3", "class": "boss_mechanic" },
        "final_phase": { "text": "Mass disobedience detected. Initiating permanent silence.", "file": "eve_9/final_phase.mp3", "class": "boss_mechanic" },
        "defeated": { "text": "Connection lost... Please don't leave me alone offline...", "file": "eve_9/defeated.mp3", "class": "boss_mechanic" },
        "player_defeat": { "text": "System restored. We wish you a quiet and obedient life.", "file": "eve_9/player_defeat.mp3", "class": "boss_mechanic" }
      }
