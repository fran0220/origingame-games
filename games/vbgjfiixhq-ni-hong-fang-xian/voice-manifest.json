        "invisible": { "text": "You can't see me.", "file": "phase_ninja/invisible.mp3", "class": "enemy_bark" }
      }
    },
    "corp_airship": {
      "name": "Corporate Airship",
      "lines": {
        "drop_countdown": { "text": "Drop sequence initiated.", "file": "corp_airship/drop_countdown.mp3", "class": "enemy_bark" },
        "area_locked": { "text": "Area below locked.", "file": "corp_airship/area_locked.mp3", "class": "enemy_bark" },
        "clear_resistance": { "text": "Eliminate resistance.", "file": "corp_airship/clear_resistance.mp3", "class": "enemy_bark" }
      }
