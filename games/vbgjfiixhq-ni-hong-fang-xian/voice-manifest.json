    "data_devourer": {
      "name": "Data Devourer",
      "lines": {
        "open_port": { "text": "Open port detected.", "file": "data_devourer/open_port.mp3", "class": "enemy_bark" },
        "strip_access": { "text": "Stripping access privileges.", "file": "data_devourer/strip_access.mp3", "class": "enemy_bark" },
