{
  "version": 2,
  "language": "en-US",
  "format": "mp3",
  "audioRoot": "assets/audio/voices",
  "mixPolicy": {
    "maxConcurrentVoices": 2,
    "interruptLowerPriority": true,
    "classes": {
      "boss_mechanic": { "priority": 100, "cooldownSec": 0 },
      "battle_warning": { "priority": 80, "cooldownSec": 2 },
      "tactical_feedback": { "priority": 40, "cooldownSec": 3 },
      "character_flavor": { "priority": 20, "cooldownSec": 20 },
      "enemy_bark": { "priority": 10, "cooldownSec": 12 }
    }
  },
  "actors": {
    "lan": {
      "name": "Commander Lan",
      "lines": {
        "opening": { "text": "Line is open. Tonight, this city is ours to defend.", "file": "lan/opening.mp3", "class": "battle_warning" },
        "enemy_incoming": { "text": "Signal in the west sector. Prepare to engage.", "file": "lan/enemy_incoming.mp3", "class": "battle_warning" },
        "route_split": { "text": "They've changed course. Reposition your fire.", "file": "lan/route_split.mp3", "class": "battle_warning" },
        "node_attacked": { "text": "Someone's chewing through the firewall. Deal with it.", "file": "lan/node_attacked.mp3", "class": "battle_warning" },
        "fortress_damaged": { "text": "The data core took a hit. Don't let them get close again.", "file": "lan/fortress_damaged.mp3", "class": "battle_warning" },
        "final_wave": { "text": "No way back. Push every watt into the line.", "file": "lan/final_wave.mp3", "class": "battle_warning" },
        "victory": { "text": "The signal's still alive. So are we.", "file": "lan/victory.mp3", "class": "battle_warning" },
        "defeat": { "text": "Core lost... Cut the line. Leave no identities behind.", "file": "lan/defeat.mp3", "class": "battle_warning" }
      }
    },
    "gray_falcon": {
      "name": "Railgun Sniper: Gray Falcon",
      "lines": {
        "build": { "text": "Clear sightline. Railgun online.", "file": "gray_falcon/build.mp3", "class": "tactical_feedback" },
        "select": { "text": "Coordinates.", "file": "gray_falcon/select.mp3", "class": "character_flavor" },
        "upgrade": { "text": "Calibration complete. The next shot will be cleaner.", "file": "gray_falcon/upgrade.mp3", "class": "tactical_feedback" },
        "elite_kill": { "text": "Armor is just expensive packaging.", "file": "gray_falcon/elite_kill.mp3", "class": "character_flavor" },
        "multi_pierce": { "text": "One line. All clear.", "file": "gray_falcon/multi_pierce.mp3", "class": "character_flavor" },
        "skill_charge": { "text": "Don't blink.", "file": "gray_falcon/skill_charge.mp3", "class": "tactical_feedback" },
        "skill_fire": { "text": "Piercing shot.", "file": "gray_falcon/skill_fire.mp3", "class": "tactical_feedback" },
        "jammed": { "text": "Optics distorted. I need a reboot.", "file": "gray_falcon/jammed.mp3", "class": "battle_warning" }
      }
    },
    "spark": {
      "name": "Arc Engineer: Spark",
      "lines": {
        "build": { "text": "Hook up the power. Let's light this block.", "file": "spark/build.mp3", "class": "tactical_feedback" },
        "select": { "text": "Who do you want dancing?", "file": "spark/select.mp3", "class": "character_flavor" },
        "upgrade": { "text": "Double the voltage. Kill the safeties.", "file": "spark/upgrade.mp3", "class": "tactical_feedback" },
        "chain_attack": { "text": "One after another!", "file": "spark/chain_attack.mp3", "class": "character_flavor" },
        "wet_target": { "text": "Puddles? Even better.", "file": "spark/wet_target.mp3", "class": "character_flavor" },
        "mechanical_kill": { "text": "Smell that? Burnt circuitry.", "file": "spark/mechanical_kill.mp3", "class": "character_flavor" },
        "skill": { "text": "Grid-wide overload!", "file": "spark/skill.mp3", "class": "tactical_feedback" },
        "shutdown": { "text": "Okay. That one really tripped the breaker.", "file": "spark/shutdown.mp3", "class": "battle_warning" }
      }
    },
    "iron_fist": {
      "name": "Mercenary Captain: Iron Fist",
      "lines": {
        "build": { "text": "This street is ours now.", "file": "iron_fist/build.mp3", "class": "tactical_feedback" },
        "select": { "text": "Say the word. Who are we blocking?", "file": "iron_fist/select.mp3", "class": "character_flavor" },
        "shield_mode": { "text": "Shields forward. Nobody gets through.", "file": "iron_fist/shield_mode.mp3", "class": "tactical_feedback" },
        "blade_mode": { "text": "Drop shields. Draw blades.", "file": "iron_fist/blade_mode.mp3", "class": "tactical_feedback" },
        "intercept_elite": { "text": "Big guy, end of the line.", "file": "iron_fist/intercept_elite.mp3", "class": "character_flavor" },
        "teammate_down": { "text": "Hold this position. I'll drag him back.", "file": "iron_fist/teammate_down.mp3", "class": "battle_warning" },
        "skill": { "text": "Everyone, push!", "file": "iron_fist/skill.mp3", "class": "tactical_feedback" },
        "retreat": { "text": "This isn't running. We're just finding somewhere else to hit them.", "file": "iron_fist/retreat.mp3", "class": "character_flavor" }
      }
    },
    "zero_day": {
      "name": "Hacker: Zero Day",
      "lines": {
        "build": { "text": "Ancient interface. Still usable.", "file": "zero_day/build.mp3", "class": "tactical_feedback" },
        "select": { "text": "Who forgot to change their password this time?", "file": "zero_day/select.mp3", "class": "character_flavor" },
        "break_shield": { "text": "Firewall? More like a paper door.", "file": "zero_day/break_shield.mp3", "class": "character_flavor" },
        "control_enemy": { "text": "I'll borrow your gun.", "file": "zero_day/control_enemy.mp3", "class": "character_flavor" },
        "capture_node": { "text": "Privileges transferred. I'm the administrator now.", "file": "zero_day/capture_node.mp3", "class": "battle_warning" },
        "hack_failed": { "text": "Interesting. It actually fought back.", "file": "zero_day/hack_failed.mp3", "class": "character_flavor" },
        "skill": { "text": "Whole city's offline. Except us.", "file": "zero_day/skill.mp3", "class": "tactical_feedback" },
        "data_kill": { "text": "Deleted. No recycle bin.", "file": "zero_day/data_kill.mp3", "class": "character_flavor" }
      }
    },
    "queen_bee": {
      "name": "Drone Technician: Queen Bee",
      "lines": {
        "build": { "text": "Hive deployed. Little ones, prepare for launch.", "file": "queen_bee/build.mp3", "class": "tactical_feedback" },
        "select": { "text": "Airspace status?", "file": "queen_bee/select.mp3", "class": "character_flavor" },
        "anti_air_mode": { "text": "Falcon module. Scan for high-altitude targets.", "file": "queen_bee/anti_air_mode.mp3", "class": "tactical_feedback" },
        "repair_mode": { "text": "Repair team, save what can still be saved.", "file": "queen_bee/repair_mode.mp3", "class": "tactical_feedback" },
        "bomb_mode": { "text": "Payload mounted. Clear the street.", "file": "queen_bee/bomb_mode.mp3", "class": "tactical_feedback" },
        "drone_destroyed": { "text": "Drone Three just went dark... Put it on the ledger.", "file": "queen_bee/drone_destroyed.mp3", "class": "battle_warning" },
        "skill": { "text": "Swarm, launch.", "file": "queen_bee/skill.mp3", "class": "tactical_feedback" },
        "return": { "text": "All units return to hive. Damage report.", "file": "queen_bee/return.mp3", "class": "character_flavor" }
      }
    },
    "gang_cyborg": {
      "name": "Gang Cyborg",
      "lines": {
        "bounty": { "text": "Bounty's mine!", "file": "gang_cyborg/bounty.mp3", "class": "enemy_bark" },
        "charge": { "text": "Push through!", "file": "gang_cyborg/charge.mp3", "class": "enemy_bark" },
        "weak_firepower": { "text": "They barely have any firepower!", "file": "gang_cyborg/weak_firepower.mp3", "class": "enemy_bark" }
      }
    },
    "riot_machine": {
      "name": "Riot Suppression Unit",
      "lines": {
        "lockdown": { "text": "Enforcing lockdown.", "file": "riot_machine/lockdown.mp3", "class": "enemy_bark" },
